# Copy to .env and adjust. Bun loads .env automatically — do not use dotenv.
# Every variable here is read by loadConfig() in src/config.ts.

# 'production' or 'development'. Defaults to development.
NODE_ENV=development

# HTTP listen port. Must be >= 1024 (non-privileged). Defaults to 3001.
PORT=3001

# Secret key for OwnTracks encrypted payloads. Stored as UTF-16, NOT base64.
# Must be exactly 32 bytes — the placeholder below is 32 ASCII characters.
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Redis connection, used for geofence areas and event pub/sub.
# Defaults to redis://localhost:6379.
REDIS_URL=redis://localhost:6379

# Seconds a location must stay outside an area before an exit event fires.
# This cushion suppresses churn from GPS jitter. Defaults to 60.
GEOFENCE_EXIT_THRESHOLD_SECONDS=60

# Storage backend selection:
#   POSTGRES_PASSWORD set   -> Postgres is used
#   POSTGRES_PASSWORD unset -> falls back to SQLite at DB_PATH
# Leave POSTGRES_PASSWORD commented out for a zero-dependency local run.
DB_PATH=location-tracker.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=location_tracker
POSTGRES_DB=location_tracker
# POSTGRES_PASSWORD=location_tracker

# MQTT broker for the `mqtt` entrypoint. Defaults to mqtt://localhost:1883.
MQTT_BROKER_URL=mqtt://localhost:1883
